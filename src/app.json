{
  "configVersion": "v3",
  "app": {
    "appId": 20042,
    "appName": "OTP Auth",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "binary poetry gmbh",
    "description": "Time-based one-time passwords on your wrist"
  },
  "permissions": ["device:os.local_storage"],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.2",
      "minVersion": "3.6"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": ["page/index", "page/probe/index", "page/probe/scrollList"]
