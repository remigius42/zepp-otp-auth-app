        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 466
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "OTP Auth"
    },
    "de-DE": {
      "appName": "OTP Auth"
    }
  },
  "defaultLanguage": "en-US"
