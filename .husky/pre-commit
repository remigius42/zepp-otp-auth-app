# See https://github.com/typicode/husky/releases/tag/v9.0.1
# shellcheck disable=SC2148
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose
npx lint-staged --max-arg-length 255
