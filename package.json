{
  "name": "zepp-otp-auth-app",
  "version": "0.1.0",
  "description": "Time-based one-time passwords (TOTP) on Amazfit / Zepp OS watches",
  "license": "GPL-3.0-or-later",
  "author": "Andreas Remigius Schmidt <remigius42-github.dcds7@aleeas.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remigius42/zepp-otp-auth-app.git"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "compile": "node bin/compile.mjs",
    "compile:watch": "node bin/compile.mjs --watch",
    "build": "npm run generate-licenses-data && npm run compile && cd build/zeus && zeus build",
    "dev": "npm run compile && cd build/zeus && zeus dev",
    "preview": "npm run compile && cd build/zeus && zeus preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:prettier && npm run lint:cspell && npm run lint:markdown && npm run lint:oxlint && npm run typecheck",
    "lint:prettier": "prettier --no-error-on-unmatched-pattern --ignore-unknown --list-different '**/*'",
    "lint:cspell": "cspell --dot --no-must-find-files --no-progress '**/*'",
    "lint:markdown": "markdownlint-cli2 '**/*.md' '!node_modules/**'",
    "lint:oxlint": "oxlint --max-warnings=0",
    "lint:fix": "npm run lint:fix:prettier && npm run lint:fix:oxlint",
    "lint:fix:prettier": "prettier --write '**/*'",
    "lint:fix:oxlint": "oxlint --fix",
    "generate-licenses-data": "./bin/generate_licenses_data.sh",
    "check-licenses": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;BSD-3-Clause;Apache-2.0;0BSD\" --excludePrivatePackages"
  },
  "_moduleAliases": {
    "zeppos-app-utils": "node_modules/@zeppos/zeus-cli/private-modules/zeppos-app-utils"
  },
  "dependencies": {
    "@zeppos/zml": "0.0.43",
    "base32-decode": "1.0.0",
    "crypto-js": "4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cspell/dict-de-ch": "^1.3.2",
    "@types/crypto-js": "4.2.2",
    "@vitest/coverage-v8": "3.2.4",
    "@zeppos/device-types": "4.0.0",
    "@zeppos/zeus-cli": "1.9.3",
    "cspell": "9.2.0",
    "esbuild": "0.25.9",
    "husky": "^9.1.7",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.5.0",
    "markdownlint-cli2": "0.18.1",
    "oxlint": "1.22.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
